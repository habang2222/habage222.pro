FROM docker.io/kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive
RUN printf 'deb [signed-by=/usr/share/keyrings/kali-archive-keyring.gpg] http://mirror.wonchan.net/kali kali-rolling main contrib non-free non-free-firmware\n' > /tmp/habang-kali.list \
    && apt-get -o Dir::Etc::sourcelist=/tmp/habang-kali.list -o Dir::Etc::sourceparts=- -o APT::Update::Error-Mode=any update \
    && apt-get -o Dir::Etc::sourcelist=/tmp/habang-kali.list -o Dir::Etc::sourceparts=- install -y --no-install-recommends \
        openssh-server bash python3 curl git ca-certificates procps \
        xvfb openbox x11vnc novnc websockify xterm tini \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* /tmp/habang-kali.list \
    && useradd --uid 1000 --create-home --shell /bin/bash tenant && passwd -d tenant

COPY sshd_config /etc/ssh/sshd_config
COPY entrypoint.sh /usr/local/bin/workspace-start
RUN chmod 755 /usr/local/bin/workspace-start
EXPOSE 2222
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/workspace-start"]
