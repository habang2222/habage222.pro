[Unit]
Description=habang site membership and comments
After=network.target

[Service]
User=habang222
Group=habang222
WorkingDirectory=/srv/files/app
EnvironmentFile=/srv/files/config/community.env
ExecStart=/srv/files/venv/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:8080 --timeout 40 --no-control-socket --error-logfile - app:create_app()
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/files/data

[Install]
WantedBy=multi-user.target
